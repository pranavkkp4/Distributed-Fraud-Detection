# syntax=docker/dockerfile:1.7
FROM golang:1.26-alpine AS build
WORKDIR /src/serving_plane
COPY serving_plane/go.mod serving_plane/go.sum* ./
RUN go mod download
COPY serving_plane/ ./
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/fraud-gateway ./cmd/gateway

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/fraud-gateway /fraud-gateway
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/fraud-gateway"]
