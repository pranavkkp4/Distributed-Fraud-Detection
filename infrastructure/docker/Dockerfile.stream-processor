# syntax=docker/dockerfile:1.7
FROM golang:1.26-alpine AS build
WORKDIR /src/stream_processor
COPY stream_processor/go.mod stream_processor/go.sum* ./
RUN go mod download
COPY stream_processor/ ./
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/fraud-stream-processor ./cmd/stream-processor

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/fraud-stream-processor /fraud-stream-processor
EXPOSE 8082
USER 65532:65532
ENTRYPOINT ["/fraud-stream-processor"]
