# Development-only credentials. Replace them through a secret manager outside
# local Compose/Minikube environments.
FRAUD_AUTH_TOKEN=local-development-token
FRAUD_WORKER_AUTH_TOKEN=local-worker-token
# Required to permit plaintext local Compose/CI transport. Never set in a
# shared or production deployment; configure TLS/mTLS file paths instead.
FRAUD_DEVELOPMENT_INSECURE=true

# Production container health checks use HTTPS and verify certificates. The
# platform trust store is used when these CA variables are unset. Set a CA path
# for a private PKI and, when the certificate does not contain 127.0.0.1, set
# the corresponding DNS server name.
# FRAUD_GATEWAY_TLS_CA_FILE=/run/secrets/gateway-ca.pem
# FRAUD_GATEWAY_TLS_SERVER_NAME=fraud-gateway.internal
# FRAUD_WORKER_HTTP_TLS_CA_FILE=/run/secrets/worker-http-ca.pem
# FRAUD_WORKER_HTTP_TLS_SERVER_NAME=fraud-worker.internal

# Gateway deadline phases. These relaxed local values are not an SLO claim.
FRAUD_TIMEOUT=40ms
FRAUD_FEATURE_TIMEOUT=10ms
FRAUD_QUEUE_DELAY=2ms
FRAUD_INFERENCE_TIMEOUT=20ms
FRAUD_WORKER_DIAL_TIMEOUT=2s
FRAUD_WORKER_PROBE_INTERVAL=1s

# Redis
REDIS_ADDR=redis:6379
REDIS_TIMEOUT=10ms
# Production (when FRAUD_DEVELOPMENT_INSECURE is absent) uses TLS 1.3 and
# requires a password or client-certificate identity. Keep secrets in a secret
# manager; these names are intentionally left unset in the development file.
# REDIS_USERNAME=fraud-service
# REDIS_PASSWORD=<secret-manager-reference>
# REDIS_TLS_CA_FILE=/run/secrets/redis-ca.pem
# REDIS_TLS_SERVER_NAME=redis.internal
# REDIS_TLS_CERT_FILE=/run/secrets/redis-client.pem
# REDIS_TLS_KEY_FILE=/run/secrets/redis-client-key.pem

# Streaming
KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC=transactions
KAFKA_GROUP_ID=fraud-feature-materializer
KAFKA_MAX_ATTEMPTS=3
KAFKA_RETRY_BACKOFF=50ms
KAFKA_POISON_POLICY=halt
# Only used when KAFKA_POISON_POLICY=dlq. It must be a different topic from
# KAFKA_TOPIC; the processor writes synchronously with RequireAll before it
# commits the failed source record.
KAFKA_DLQ_TOPIC=
# Production Kafka uses TLS 1.3 and requires either SCRAM-SHA-512 or a TLS
# client identity. Source reads and built-in DLQ writes share this policy.
# KAFKA_TLS_CA_FILE=/run/secrets/kafka-ca.pem
# KAFKA_TLS_SERVER_NAME=kafka.internal
# KAFKA_TLS_CERT_FILE=/run/secrets/kafka-client.pem
# KAFKA_TLS_KEY_FILE=/run/secrets/kafka-client-key.pem
# KAFKA_SASL_USERNAME=fraud-stream
# KAFKA_SASL_PASSWORD=<secret-manager-reference>
STREAM_WINDOW=5m
STREAM_MAX_ENTITIES=100000
STREAM_MAX_EVENTS=1000000
# STREAM_PROCESSOR_TLS_CERT_FILE=/run/secrets/stream-http.pem
# STREAM_PROCESSOR_TLS_KEY_FILE=/run/secrets/stream-http-key.pem

# Local dashboards
GRAFANA_ADMIN_PASSWORD=fraud-local-only
